# ── AEGIS MissionOS — local development environment ──────────────
# Copy to .env and adjust. Never commit real secrets.

# Postgres
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://aegis:change-me-locally@localhost:5432/aegis

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (vector store for SentinelAI, Phase 3)
QDRANT_URL=http://localhost:6333

# API
AEGIS_ENV=local
AEGIS_SECRET_KEY=generate-with--openssl-rand-hex-32
AEGIS_ACCESS_TOKEN_TTL_MINUTES=15
AEGIS_CORS_ORIGINS=["http://localhost:5173"]

# --- Identity (Phase 6) ---
# Dedicated data-at-rest key (Fernet, urlsafe base64). Derived from secret key if unset.
AEGIS_ENCRYPTION_KEY=
# OIDC SSO: all four required to enable; leave empty to disable SSO.
AEGIS_OIDC_ISSUER=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=
AEGIS_OIDC_REDIRECT_URL=
AEGIS_OIDC_AUTO_PROVISION=false
grep -n "phase" README.md | head -15
# Live data ingestion (Phase 11) — Celestrak + NOAA SWPC, no credentials needed
AEGIS_DATA_SOURCE=seed          # "live" enables background polling
AEGIS_INGEST_CATALOG_GROUP=active

# SentinelAI live provider (Phase 19) — key from Secrets Manager in deploys
# ANTHROPIC_API_KEY=sk-ant-...
AEGIS_SENTINEL_MODEL=claude-sonnet-5

# Space-Track.org (Phase 22) — no API key exists for this service; it's
# your registered account's username/password. Optional: SOCRATES/
# Celestrak ingestion works fully without it.
# SPACETRACK_USERNAME=you@example.com
# SPACETRACK_PASSWORD=your-space-track-password
